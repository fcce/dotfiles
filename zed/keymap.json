      "secondary-.": "pane::ActivateNextItem",
      "secondary-shift-e": "project_panel::ToggleFocus",
      "secondary-shift-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "os == macos",
    "bindings": {
